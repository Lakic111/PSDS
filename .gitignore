# Claude Code tooling (machine-specific)
.claude/
# ...ali projektni skills IDU u repo (dele se sa timom / preziveju reinstalaciju).
# Ostatak .claude/ (settings.local.json, istorija) ostaje ignorisan.
!.claude/
!.claude/skills/
!.claude/skills/**

# Vivado / Vitis generisani projekat (regenerise se iz src/vhdl/script/*.tcl)
src/vhdl/result/

# Vivado / XSim generisani fajlovi (bilo gde)
*.jou
*.log
*.backup.jou
*.backup.log
.Xil/
xsim.dir/
*.wdb
*.wcfg
*.pb
*.rpx
*.str
webtalk*
usage_statistics*
vivado_pid*

# Zip arhive izvora (drzimo raspakovano)
src/vhdl.zip

# xsim build dirovi (drzimo samo spakovan IP u src/vhdl_NCC_IP/ip_repo/ncc_accel_1_0/;
# src/vhdl/ip/ je uklonjen u Koraku 7 -- ip_repo je jedini merodavan izvor)
src/vhdl/work_*/
src/vhdl_NCC_IP/ncc_ip/
src/vhdl_NCC_IP/ip_repo/edit_ncc_accel_v1_0.*

# Privremeni screenshotovi
Screenshot*.png

# OS junk
Thumbs.db
.DS_Store
desktop.ini

# Obsidian per-user UI stanje
PSDS Vault/.obsidian/workspace.json
PSDS Vault/.obsidian/workspace-mobile.json

# Vitis radni prostor (generisan iz XSA skriptama u src/vitis/scripts/)
src/vitis/ws/

# Vivado batch artefakti u korenu repoa
# NA/ pravi apply_board_preset (PS7 summary) na relativnu putanju.
NA/
clockInfo.txt
dfx_runtime.txt
src/vhdl_NCC_IP.zip

# Rezervna kopija pune verzije dokumentacije -- git vec cuva prethodnu verziju.
*.html.bak
